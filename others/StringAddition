// Stringでの整数の足し算

string add(const string& p,const string& f)
{
    string ans;
    int carry = 0;
    int i = f.size() - 1;
    int j = p.size() - 1;
    while(i >= 0 || j >= 0 || carry)
    {
        if(i >= 0)carry += f[i--] - '0';
        if(j >= 0)carry += p[j--] - '0';
        ans += carry % 10 + '0';
        carry /= 10;
    }
    reverse(ans.begin(),ans.end());
    return ans;
}
